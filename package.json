{
  "name": "ticket-booking-api",
  "version": "1.0.0",
  "description": "Minimal ticket booking API (Node.js, Express, SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  }
}
